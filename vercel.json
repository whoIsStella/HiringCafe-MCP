{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,.github/**,dist/**,Dockerfile.vercel}"
    }
  },
  "routes": [
    {"src": "/(?:health)?", "dest": "/health.json"},
    {"src": "/mcp/?", "dest": "/api/index.py"},
    {"handle": "filesystem"},
    {"src": "/.*", "status": 404, "dest": "/404.json"}
  ]
}
